# Woodcroft configuration.
#
# Local development: copy this file to backend/.env. The defaults below work
# against the database that scripts\db_create.ps1 provisions.
#
# Production: set these as environment variables on the host (Vercel project
# settings, etc). Never commit a filled-in copy. In APP_ENV=production the app
# refuses to start with a placeholder SECRET_KEY, DEBUG=true, or a localhost
# CORS origin. See DEPLOY.md.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Woodcroft
APP_ENV=development
DEBUG=true
# Production: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# MUST be postgresql+psycopg:// (psycopg 3). Bare postgresql:// resolves to psycopg2 and fails.
# Managed Postgres: use the POOLED endpoint.
DATABASE_URL=postgresql+psycopg://woodcroft:woodcroft@localhost:5432/woodcroft_dev
TEST_DATABASE_URL=postgresql+psycopg://woodcroft:woodcroft@localhost:5432/woodcroft_test
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_DAYS=90
JWT_ALGORITHM=HS256
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=2

# ─── Store defaults (overridable at runtime in Admin → Settings) ──────────────
STORE_CURRENCY=PKR
STORE_TIMEZONE=Asia/Karachi
TAX_MODE=inclusive
DEFAULT_TAX_RATE_BP=1800          # 18.00% in basis points
COD_SURCHARGE_PAISA=20000         # Rs 200
FREE_SHIPPING_THRESHOLD_PAISA=2000000  # Rs 20,000

# ─── Notifications ────────────────────────────────────────────────────────────
# Default driver writes rendered messages to the DB outbox (Admin → Notifications).
# Set to "smtp" / "sms_gateway" once real credentials exist.
EMAIL_DRIVER=outbox
SMS_DRIVER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@woodcroft.pk
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
# COD is the only live provider. Wallet providers stay disabled until credentials exist.
PAYMENT_COD_ENABLED=true
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_ENABLED=false
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# ─── Media ────────────────────────────────────────────────────────────────────
MEDIA_ROOT=media
# An absolute URL (a CDN delivery prefix) skips the local static mount, which is
# required on a read-only serverless filesystem.
MEDIA_URL=/media
# Seed imagery: "generated" (default, offline) or "curated" (needs PEXELS_API_KEY).
SEED_IMAGE_MODE=generated
PEXELS_API_KEY=

# ─── Cloudinary (hosts admin image uploads when the filesystem is ephemeral) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── URLs and CORS ────────────────────────────────────────────────────────────
# PUBLIC_URL is the absolute base for links in emails. In production it MUST be
# the real https origin, or customers receive localhost links.
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Workers ──────────────────────────────────────────────────────────────────
# Set false where there is no long-lived process; a scheduler then drives
# /api/cron/run-jobs instead, guarded by CRON_SECRET.
ENABLE_BACKGROUND_WORKER=true
WORKER_POLL_SECONDS=10
STOCK_RESERVATION_TTL_MINUTES=20
CRON_SECRET=

# ─── Rate limits (slowapi syntax) ─────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_CHECKOUT=20/minute
# Empty = in-process memory. Point at Redis wherever the app runs as more than
# one process, or each instance enforces the limit separately.
RATELIMIT_STORAGE_URI=
