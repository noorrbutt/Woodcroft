# ─── Docker Compose production (REQUIRED at ./.env before `docker compose up`) ─
# Copy this file to ./.env and fill these three. Compose refuses to start without them.
SECRET_KEY=change-me-to-48-plus-random-chars       # python -c "import secrets;print(secrets.token_urlsafe(48))"
DB_PASSWORD=change-me-to-a-strong-db-password      # never leave as 'woodcroft'
PUBLIC_URL=https://your-domain.pk                  # https, no trailing slash, NOT localhost (drives CORS + email links)
EMAIL_DRIVER=outbox                                # 'smtp' once real SMTP_* creds exist
# Admin is created separately and securely (never seeded in production):
#   docker compose exec -e WOODCROFT_ADMIN_EMAIL=you@domain.pk -e WOODCROFT_ADMIN_PASSWORD='<strong>' api python -m scripts.create_admin

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Woodcroft
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
# MUST be postgresql+psycopg:// (psycopg 3). Bare postgresql:// resolves to psycopg2 and fails.
DATABASE_URL=postgresql+psycopg://woodcroft:woodcroft@localhost:5432/woodcroft_dev
TEST_DATABASE_URL=postgresql+psycopg://woodcroft:woodcroft@localhost:5432/woodcroft_test
DB_ECHO=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_DAYS=90
JWT_ALGORITHM=HS256
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ─── Store defaults (overridable at runtime in Admin → Settings) ──────────────
STORE_CURRENCY=PKR
STORE_TIMEZONE=Asia/Karachi
TAX_MODE=inclusive
DEFAULT_TAX_RATE_BP=1800          # 18.00% in basis points
COD_SURCHARGE_PAISA=20000         # Rs 200
FREE_SHIPPING_THRESHOLD_PAISA=2000000  # Rs 20,000

# ─── Notifications ────────────────────────────────────────────────────────────
# Default driver writes rendered messages to the DB outbox (Admin → Notifications).
# Set to "smtp" / "sms_gateway" once real credentials exist.
EMAIL_DRIVER=outbox
SMS_DRIVER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@woodcroft.pk
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
# COD is the only live provider. Wallet providers stay disabled until credentials exist.
PAYMENT_COD_ENABLED=true
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_ENABLED=false
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# ─── Media ────────────────────────────────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media
# Seed imagery: "generated" (default, offline) or "curated" (needs the key below)
SEED_IMAGE_MODE=generated
UNSPLASH_ACCESS_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Workers ──────────────────────────────────────────────────────────────────
ENABLE_BACKGROUND_WORKER=true
WORKER_POLL_SECONDS=10
STOCK_RESERVATION_TTL_MINUTES=20
