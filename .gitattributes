# Auto detect text files and perform LF normalization
* text=auto

# Explicit line endings — PowerShell needs CRLF, everything else LF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.webp  binary
*.woff2 binary
*.pdf   binary
